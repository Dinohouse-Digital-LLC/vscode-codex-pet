.vscode/**
src/**
.gitignore
tsconfig.json
**/*.map
docs/**
TODO.md
.DS_Store
**/.DS_Store
*.zip
**/*.zip
# vsce reads only .vscodeignore once it exists (no .gitignore fallback), so
# anything gitignored for being scratch/output must be repeated here or it
# still ends up in the packaged VSIX. pets/_runs in particular is ~230MB of
# working files from the sprite pipeline, not shipped pet assets.
pets/_runs/**
pets/**/validation-installed-*.json
pets/**/motion-report-*.json
# Unused duplicate: cat-stack's pet.json points at spritesheet.webp, not this.
pets/cat-stack/spritesheet.png
# QA/debug artifacts from the nonstandard-seamless sprite pipeline: contact
# sheets, per-state preview gifs, and the raw PNG export (manifests point at
# the .webp).
pets/**/contact-sheet*.png
pets/**/nonstandard-seamless/previews/**
pets/**/spritesheet-seamless.png
pets/**/bottom-alignment-report.json
pets/**/size-normalization-report.json
pets/**/validation-source-keyframes.json
pets/**/backup-*/**
# nonstandard-fluid is a sprite variant the extension never loads; keep it out
# of the VSIX (each fluid dir is ~40MB of unused png/webp/preview scratch).
pets/**/nonstandard-fluid/**
